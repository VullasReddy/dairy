# Copy to .env and edit.  NEVER commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_HOURS=12

# Development default is SQLite (no setup). For production use MySQL:
# DATABASE_URL=mysql+pymysql://aditya:StrongPassword@localhost:3306/aditya_milk_dairy?charset=utf8mb4
DATABASE_URL=

# Frontend address (used in email links and CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payments: mock (test mode, no real money) | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional – if empty, emails are printed to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Aditya Milk Dairy <no-reply@adityamilkdairy.com>

# 1 = development (returns verify/reset tokens in API responses for testing). Set 0 in production.
DEV_MODE=1

# WhatsApp Business (optional, Meta WhatsApp Cloud API) – also enable "WhatsApp notifications" in Admin -> Settings
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

# Rate limiting on login/register/password reset/contact/checkout. Use redis://host:6379 with several workers.
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# Business timezone for delivery days
BUSINESS_TZ=Asia/Kolkata
